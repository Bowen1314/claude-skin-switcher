        "text-secondary": "#3b414b",
        "text-muted": "#555c67"
      }
    },
    "dark": {
      "anchors": {
        "surface-0": "#0e1013",
        "surface-1": "#14171b",
        "surface-2": "#1a1d22",
        "surface-3": "#1f2328",
        "text-primary": "#e6e9ee",
        "text-secondary": "#b4bac4",
        "text-muted": "#8a919c"
      }
