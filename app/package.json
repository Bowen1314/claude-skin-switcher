{
  "name": "claude-theme-switcher",
  "productName": "Claude Skin Switcher",
  "version": "0.2.3",
  "private": true,
  "description": "Pick a look for the Claude desktop app; a small bridge plugin applies it.",
  "author": "Soso Technologies LLC",
  "license": "MIT",
  "homepage": "https://github.com/Bowen1314/claude-skin-switcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.sosotech.claude-skin-switcher",
    "productName": "Claude Skin Switcher",
    "copyright": "Copyright © 2026 Soso Technologies LLC",
    "artifactName": "claude-skin-switcher-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "!renderer/previews{,/**}",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.claude-plugin",
        "to": "marketplace/.claude-plugin"
      },
      {
        "from": "../plugin",
        "to": "marketplace/plugin",
        "filter": [
          "**/*",
          "!tests{,/**}"
        ]
      },
      {
        "from": "../shared/skin-validate.js",
        "to": "shared/skin-validate.mjs"
      },
      {
        "from": "../shared/fingerprint.js",
        "to": "shared/fingerprint.mjs"
      },
      {
        "from": "../plugin/hooks/make-colors.js",
        "to": "shared/make-colors.mjs"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Claude Skin Switcher"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bowen1314",
        "repo": "claude-skin-switcher"
      }
    ]
  }
}
